; Postcode Wars (working title) — click-only UK crime RPG.
; Godot 4.x, UI-only, PORTRAIT.

config_version=5

[application]

config/name="Postcode Wars"
config/description="from wasteman to Top Boy, one postcode at a time"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/show_image=false

[autoload]

Config="*res://autoload/config.gd"
Save="*res://autoload/save.gd"
Events="*res://autoload/events.gd"
Cloud="*res://autoload/cloud.gd"
ServerGateway="*res://autoload/server_gateway.gd"
Game="*res://autoload/game.gd"
Cast="*res://autoload/cast.gd"
Story="*res://autoload/story.gd"
Director="*res://autoload/director.gd"
Greeter="*res://autoload/greeter.gd"
Threads="*res://autoload/threads.gd"
Ambush="*res://autoload/ambush.gd"
Telemetry="*res://autoload/telemetry.gd"
Audio="*res://autoload/audio.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.070588, 0.078431, 0.090196, 1)
textures/vram_compression/import_etc2_astc=true
